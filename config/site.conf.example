# deploy-kit — per-site config. One file per site on the droplet, e.g.
#   /etc/deploy-kit/aviewfromthebridge.conf
# Sourced by deploy.sh. Pick a PROFILE and fill the maps for that stack.
# (bash associative arrays — Ubuntu 24.04 bash 5 is fine.)

# ============================================================================
# EXAMPLE A — Mythus/IX WordPress site (View / Matchbook / Celeb Auto /
#             vincentragosta.io / ellenharvey)
# ============================================================================
PROFILE=mythus-ix
THEME=aviewfromthebridge          # child theme directory name
PHP_VER=8.4                       # 8.4 (View/MBF), 8.3 (CA), etc.
FPM_ACTION=restart                # restart (drops OPcache hard) | reload
REDIS=0                           # 1 if a persistent object cache is enabled
# GATED=1                         # site answers anonymous visitors with a password
#                                 # gate (HTTP 401) — e.g. 3 Summers of Lincoln. The
#                                 # smoke test and verify-site.sh then expect 401 on
#                                 # the homepage and assert the gate is never cached.

declare -A DEPLOY_DIR=(
  [main]=/var/www/viewfromthebridgeplay.com/public
  [develop]=/var/www/avftb-staging/public
)
declare -A ENV_NAME=(
  [main]=production
  [develop]=staging
)
declare -A CACHE_DIR=(
  [main]=/var/cache/nginx/fastcgi-avftb
  [develop]=/var/cache/nginx/fastcgi-avftb-staging
)

# Optional — the Unix user each environment's PHP pool runs as (default www-data).
# Set it to the same user given to fpm-pools.sh --user / --staging-user: deploys chown
# to it, lock wp-config-env.php to its group, and run wp-cron and the smoke test as it.
# declare -A POOL_USER=(
#   [main]=avftb
#   [develop]=avftb-stg
# )

# Optional, LAYOUT=releases only — extra paths every release links from shared/,
# space-separated, per branch. Production's Redis drop-in is the usual one; never share
# it into staging (it would point staging at production's cache).
# declare -A SHARED_EXTRA=(
#   [main]="wp-content/object-cache.php preview"
# )

# ============================================================================
# EXAMPLE B — Classic WP theme, no build (Shucked). DEPLOY_DIR points at the
#             THEME dir; site is uncached + opcache validate_timestamps On.
# ----------------------------------------------------------------------------
# PROFILE=classic
# declare -A DEPLOY_DIR=(
#   [main]=/var/www/shuckedmusical.com/public/wp-content/themes/shucked
#   [develop]=/var/www/staging.shuckedmusical.com/public/wp-content/themes/shucked
# )
# # If/when Shucked gains a FastCGI cache or turns validate_timestamps off:
# # PHP_VER=8.2 ; FPM_RELOAD=1 ; REDIS=1
# # declare -A CACHE_DIR=( [main]=/var/cache/nginx/... )

# ============================================================================
# EXAMPLE C — Next.js app (itzenzo.tv). DEPLOY_DIR is the app dir (in place). The app
#             runs as APP_USER under a systemd unit from provision/nextjs-service.sh;
#             the build runs as that user too. PORT drives the localhost smoke test.
# ----------------------------------------------------------------------------
# PROFILE=nextjs
# declare -A DEPLOY_DIR=(   [main]=/var/www/itzenzo.tv  [develop]=/var/www/staging.itzenzo.tv )
# declare -A ENV_NAME=(     [main]=production           [develop]=staging )
# declare -A APP_USER=(     [main]=itzenzo              [develop]=itzenzo-stg )
# declare -A SYSTEMD_UNIT=( [main]=itzenzo-tv.service   [develop]=itzenzo-tv-staging.service )
# declare -A PORT=(         [main]=3001                 [develop]=3002 )
# declare -A SITE_URL=(     [main]=https://itzenzo.tv   [develop]=https://staging.itzenzo.tv )
# declare -A POST_DEPLOY=(  [main]=scripts/warm.sh      [develop]=scripts/warm.sh )
# # Legacy: PM2_APP=itzenzo reloads a PM2 app instead (and without APP_USER the build runs as
# # root, OWNER applies) — kept only so an un-migrated box still deploys.
