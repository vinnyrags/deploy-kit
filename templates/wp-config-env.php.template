<?php
/**
 * deploy-kit — per-environment WordPress config (NOT version-controlled; the deploy
 * hook preserves it across checkouts). Rendered by new-site.sh per env; wp-config.php
 * includes it. Salts live in wp-config.php (generated by `wp config create`).
 *
 * Placeholders: {{DB_NAME}} {{DB_USER}} {{DB_PASSWORD}} {{WP_HOME}} {{WP_ENV}} {{WP_DEBUG}}
 */
define( 'DB_NAME', '{{DB_NAME}}' );
define( 'DB_USER', '{{DB_USER}}' );
define( 'DB_PASSWORD', '{{DB_PASSWORD}}' );
define( 'DB_HOST', 'localhost' );

define( 'WP_HOME', '{{WP_HOME}}' );
// Core lives in the /wp subdirectory on this fleet, so WP_SITEURL must NOT equal
// WP_HOME. If it does, site_url() resolves to the docroot and wp_login_url()
// returns /wp-login.php, which nginx 404s — wp-admin then bounces to a dead
// reauth URL and you cannot reach the dashboard at all. Matches AVFTB.
define( 'WP_SITEURL', WP_HOME . '/wp' );
define( 'WP_ENVIRONMENT_TYPE', '{{WP_ENV}}' );   // production | staging

define( 'WP_DEBUG', {{WP_DEBUG}} );
define( 'WP_DEBUG_LOG', {{WP_DEBUG}} );
define( 'WP_DEBUG_DISPLAY', false );

define( 'DISALLOW_FILE_EDIT', true );
define( 'DISALLOW_FILE_MODS', true );
define( 'FORCE_SSL_ADMIN', true );
